			<year>2025</year>
			<license>CC BY-ND 4.0</license>
		</copyright>
		<link href="https://followthevolga.ru/">
			<text>Сайт тропы «Путь Реки»</text>
			<type>text/html</type>
		</link>
	</metadata>
